<mxCell id="cmp374" value="0.50" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=7.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="424.0" y="566.4" width="600.0" height="12.0" as="geometry"/></mxCell>
<mxCell id="cmp375" value="稳态每层耗时（每卡，同一比例尺）：chunk 化 rank0 7.49 / rank1 7.53 ms；pp_full rank0 9.73 / rank1 9.72 ms → 稳态加速 1.30×；整请求 116.1 vs 144.6 ms = 1.25×。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="588.5" width="600.0" height="14.4" as="geometry"/></mxCell>
<mxCell id="cmp376" value="chunk 化每层：预取 2.92 + tail 头 0.85 + tail 余 2.39 + 空等 1.33 ms（18%）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="604.5" width="600.0" height="14.4" as="geometry"/></mxCell>
<mxCell id="cmp377" value="pp_full 每层：整段计算 4.70 ms + 传输 0.079 ms + recv 自旋等对端 4.93 ms（气泡占 51%）——两卡严格互斥，无任何 compute 重叠。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="620.5" width="600.0" height="14.4" as="geometry"/></mxCell>
<mxCell id="cmp378" value="**气泡不是带宽问题**：25 MB 的整段 activation 走 NVLink 只要 0.079 ms（≈0 GB/s），另外 4.93 ms 纯粹在等对端把整层算完。chunk 化要解决的是「让对端有活干」，不是「加快传输」。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="636.5" width="600.0" height="14.4" as="geometry"/></mxCell>
<mxCell id="cmp379" value="chunk 化把这 4.93 ms 换成下一层的预取与部分注意力（两卡同时 compute 实测 47%，聚合 144%）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="652.5" width="600.0" height="14.4" as="geometry"/></mxCell>
<mxCell id="cmp380" value="两卡时间轴对齐校验：CUPTI 时间戳跨进程可比，直接共用绝对原点；把 rank0 的 send 与 rank1 的 recv 配对，残差 +0.077 ms、反向 -0.077 ms（对称且 ≈ 一次传输耗时，旁证对齐正确）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="668.5" width="600.0" height="14.4" as="geometry"/></mxCell>
<mxCell id="cmp381" value="若错误地按「每条 trace 各自首事件」归零，会引入 1.083 ms 假位移，看起来像 rank0 的下一层与 rank1 的当前层有 ~0.9 ms 重叠——实际不存在。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="16.0" y="684.5" width="600.0" height="14.4" as="geometry"/></mxCell>
</root></mxGraphModel>
