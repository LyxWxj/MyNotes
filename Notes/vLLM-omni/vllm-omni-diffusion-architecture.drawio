        </mxCell>
        
        <!-- Step 4: Cache hooks -->
        <mxCell id="step4" value="&lt;b&gt;4. Cache Hooks 工作&lt;/b&gt;&lt;br&gt;teacache: HookRegistry 拦截 forward&lt;br&gt;cache_dit: BlockAdapter 管理缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
