        <mxCell id="target_title" value="&lt;b&gt;✅ 目标状态 (Step-wise 模式)&lt;/b&gt;" style="text;html=1;fontSize=14;fillColor=#82b366;fontColor=#FFFFFF;align=center;" vertex="1" parent="1">
