<mxfile host="app.diagrams.net">
  <diagram id="architecture-overview" name="Architecture Overview">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- User Code -->
        <mxCell id="user_code" value="&lt;b&gt;用户代码&lt;/b&gt;&lt;br&gt;omni = Omni(model=&quot;Qwen/Qwen-Image&quot;)&lt;br&gt;outputs = omni.generate(&quot;a cat&quot;, params)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="30" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 1. Omni -->
        <mxCell id="omni" value="&lt;b&gt;1. Omni&lt;/b&gt;&lt;br&gt;&lt;i&gt;entrypoints/omni.py&lt;/i&gt;&lt;br&gt;用户交互入口，参数验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 2. AsyncOmniEngine -->
        <mxCell id="async_engine" value="&lt;b&gt;2. AsyncOmniEngine&lt;/b&gt;&lt;br&gt;&lt;i&gt;engine/async_omni_engine.py&lt;/i&gt;&lt;br&gt;管理 StagePool，启动 Orchestrator 线程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="210" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 3. Orchestrator -->
        <mxCell id="orchestrator" value="&lt;b&gt;3. Orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;engine/orchestrator.py&lt;/i&gt;&lt;br&gt;编排多 Stage 请求流转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 4. StageDiffusionClient -->
        <mxCell id="stage_client" value="&lt;b&gt;4. StageDiffusionClient&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/stage_diffusion_client.py&lt;/i&gt;&lt;br&gt;ZMQ PUSH 发送请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="390" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- ZMQ Communication -->
        <mxCell id="zmq" value="&lt;b&gt;ZMQ (IPC)&lt;/b&gt;&lt;br&gt;ipc://..." style="shape=line;strokeWidth=3;strokeColor=#FF6600;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="725" y="465" width="100" height="30" as="geometry" />
        </mxCell>
        
        <!-- 5. StageDiffusionProc -->
        <mxCell id="stage_proc" value="&lt;b&gt;5. StageDiffusionProc&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/stage_diffusion_proc.py&lt;/i&gt;&lt;br&gt;子进程，持有 DiffusionEngine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="510" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 6. DiffusionEngine -->
        <mxCell id="diffusion_engine" value="&lt;b&gt;6. DiffusionEngine&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/diffusion_engine.py&lt;/i&gt;&lt;br&gt;StepScheduler + _busy_loop 主循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 7. MultiprocDiffusionExecutor -->
        <mxCell id="executor" value="&lt;b&gt;7. MultiprocDiffusionExecutor&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/executor/multiproc_executor.py&lt;/i&gt;&lt;br&gt;管理多个 Worker 进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="690" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- SHM Communication -->
        <mxCell id="shm" value="&lt;b&gt;SHM MessageQueue&lt;/b&gt;&lt;br&gt;共享内存" style="shape=line;strokeWidth=3;strokeColor=#FF0066;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="725" y="765" width="100" height="30" as="geometry" />
        </mxCell>
        
        <!-- 8. WorkerProc -->
        <mxCell id="worker_proc" value="&lt;b&gt;8. WorkerProc&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/worker/diffusion_worker.py&lt;/i&gt;&lt;br&gt;Worker 进程入口，消息循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="810" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 9. DiffusionWorker -->
        <mxCell id="diffusion_worker" value="&lt;b&gt;9. DiffusionWorker&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/worker/diffusion_worker.py&lt;/i&gt;&lt;br&gt;CUDA 设备，NCCL 分布式，LoRA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="900" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 10. DiffusionModelRunner -->
        <mxCell id="model_runner" value="&lt;b&gt;10. DiffusionModelRunner&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/worker/diffusion_model_runner.py&lt;/i&gt;&lt;br&gt;模型加载，state_cache 管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="990" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- 11. Pipeline -->
        <mxCell id="pipeline" value="&lt;b&gt;11. QwenPipeline&lt;/b&gt;&lt;br&gt;&lt;i&gt;models/qwen_image/pipeline_qwen_image.py&lt;/i&gt;&lt;br&gt;SupportsStepExecution: denoise_step() / step_scheduler() / post_decode()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="1080" width="350" height="70" as="geometry" />
        </mxCell>
        
        <!-- 12. Transformer -->
        <mxCell id="transformer" value="&lt;b&gt;12. Transformer&lt;/b&gt;&lt;br&gt;&lt;i&gt;如 QwenImageTransformer2D&lt;/i&gt;&lt;br&gt;DiT 模型计算，可应用 teacache/cache_dit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="1180" width="350" height="60" as="geometry" />
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;" edge="1" source="user_code" target="omni" parent="1">
          <mxGeometry relative="1" as="geometry" />
