        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;" edge="1" source="omni" target="async_engine" parent="1">
          <mxGeometry relative="1" as="geometry" />
