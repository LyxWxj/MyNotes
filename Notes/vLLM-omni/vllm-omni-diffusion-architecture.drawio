<diagram id="c5as0t6h-w0px" name="Step-wise Execution Flow"><mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Step-wise Diffusion 执行流程 (StepScheduler 模式)&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="40" as="geometry" />
        </mxCell>
        
        <!-- StepScheduler Box -->
        <mxCell id="scheduler_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6FA;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="300" height="500" as="geometry" />
        </mxCell>
        <mxCell id="scheduler_title" value="&lt;b&gt;StepScheduler&lt;/b&gt;&lt;br&gt;&lt;i&gt;sched/step_scheduler.py&lt;/i&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="240" height="40" as="geometry" />
        </mxCell>
        
        <!-- StepScheduler.add_request -->
        <mxCell id="add_request" value="&lt;b&gt;add_request()&lt;/b&gt;&lt;br&gt;记录 _StepProgress&lt;br&gt;(current=0, total=50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="240" height="50" as="geometry" />
        </mxCell>
        
        <!-- StepScheduler.schedule -->
        <mxCell id="schedule" value="&lt;b&gt;schedule()&lt;/b&gt;&lt;br&gt;从 _waiting 队列取出请求&lt;br&gt;返回 DiffusionSchedulerOutput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="240" height="50" as="geometry" />
        </mxCell>
        
        <!-- StepScheduler.update -->
        <mxCell id="update" value="&lt;b&gt;update_from_output()&lt;/b&gt;&lt;br&gt;更新 step_index&lt;br&gt;检查 finished 状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="240" height="50" as="geometry" />
        </mxCell>
        
        <!-- Progress State -->
        <mxCell id="progress_state" value="&lt;b&gt;_StepProgress&lt;/b&gt;&lt;br&gt;current_step: int&lt;br&gt;total_steps: int" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- Request State -->
        <mxCell id="request_state" value="&lt;b&gt;DiffusionRequestState&lt;/b&gt;&lt;br&gt;request_id: str&lt;br&gt;status: WAITING/RUNNING/FINISHED" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="440" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- DiffusionEngine Box -->
        <mxCell id="engine_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="350" height="500" as="geometry" />
        </mxCell>
        <mxCell id="engine_title" value="&lt;b&gt;DiffusionEngine&lt;/b&gt;&lt;br&gt;&lt;i&gt;diffusion/diffusion_engine.py&lt;/i&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="290" height="40" as="geometry" />
        </mxCell>
        
        <!-- _busy_loop -->
        <mxCell id="busy_loop" value="&lt;b&gt;_busy_loop()&lt;/b&gt;&lt;br&gt;主循环: schedule → execute → update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="290" height="50" as="geometry" />
        </mxCell>
        
        <!-- schedule call -->
        <mxCell id="sched_call" value="sched_output = scheduler.schedule()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="450" y="210" width="250" height="30" as="geometry" />
        </mxCell>
        
        <!-- execute call -->
        <mxCell id="exec_call" value="runner_output = execute_fn(sched_output)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="450" y="260" width="250" height="30" as="geometry" />
        </mxCell>
        
        <!-- update call -->
        <mxCell id="update_call" value="scheduler.update_from_output(sched_output, runner_output)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="450" y="310" width="250" height="30" as="geometry" />
        </mxCell>
        
        <!-- Loop Arrow -->
        <mxCell id="loop_arrow" value="&lt;b&gt;循环直到完成&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#FF6600;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="update_call" target="sched_call" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="325" />
              <mxPoint x="730" y="225" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- handle finished -->
        <mxCell id="handle_finished" value="&lt;b&gt;_handle_finished_requests()&lt;/b&gt;&lt;br&gt;通知调用方请求完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="370" width="250" height="40" as="geometry" />
        </mxCell>
        
        <!-- DiffusionExecutor Box -->
        <mxCell id="executor_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="300" height="500" as="geometry" />
        </mxCell>
        <mxCell id="executor_title" value="&lt;b&gt;MultiprocDiffusionExecutor&lt;/b&gt;&lt;br&gt;&lt;i&gt;executor/multiproc_executor.py&lt;/i&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="90" width="280" height="40" as="geometry" />
        </mxCell>
        
        <!-- execute_step -->
        <mxCell id="execute_step" value="&lt;b&gt;execute_step()&lt;/b&gt;&lt;br&gt;collective_rpc(&quot;execute_stepwise&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="240" height="50" as="geometry" />
        </mxCell>
        
        <!-- broadcast -->
        <mxCell id="broadcast" value="&lt;b&gt;broadcast_mq.enqueue()&lt;/b&gt;&lt;br&gt;广播到所有 Worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="830" y="210" width="240" height="30" as="geometry" />
        </mxCell>
        
        <!-- result dequeue -->
        <mxCell id="result_dequeue" value="&lt;b&gt;result_mq.dequeue()&lt;/b&gt;&lt;br&gt;等待 rank 0 返回" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="830" y="260" width="240" height="30" as="geometry" />
        </mxCell>
        
        <!-- Cache Backend Note -->
        <mxCell id="cache_note" value="&lt;b&gt;⚠️ Cache Backend&lt;/b&gt;&lt;br&gt;当前 step-wise 模式&lt;br&gt;不支持 cache_backend!&lt;br&gt;&lt;br&gt;&lt;i&gt;这是要集成的优化点&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="320" width="240" height="80" as="geometry" />
        </mxCell>
        
        <!-- Worker Box -->
        <mxCell id="worker_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="500" height="350" as="geometry" />
        </mxCell>
        <mxCell id="worker_title" value="&lt;b&gt;Worker 进程内部&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="200" height="30" as="geometry" />
        </mxCell>
        
        <!-- WorkerProc.execute_stepwise -->
        <mxCell id="wp_execute" value="&lt;b&gt;WorkerProc.execute_stepwise()&lt;/b&gt;&lt;br&gt;接收 RPC 消息，调用 DiffusionWorker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="200" height="50" as="geometry" />
        </mxCell>
        
        <!-- DiffusionWorker.execute_stepwise -->
        <mxCell id="dw_execute" value="&lt;b&gt;DiffusionWorker.execute_stepwise()&lt;/b&gt;&lt;br&gt;激活 LoRA，调用 ModelRunner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="200" height="50" as="geometry" />
        </mxCell>
        
        <!-- DiffusionModelRunner.execute_stepwise -->
