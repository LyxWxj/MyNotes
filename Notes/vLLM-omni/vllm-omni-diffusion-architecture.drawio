        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;strokeColor=#333333;" edge="1" source="async_engine" target="orchestrator" parent="1">
          <mxGeometry relative="1" as="geometry" />
