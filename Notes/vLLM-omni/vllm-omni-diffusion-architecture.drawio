        </mxCell>
        <mxCell id="cachedit_detail" value="&lt;ul&gt;&lt;li&gt;&lt;b&gt;DBCache (Dynamic Block Cache)&lt;/b&gt;&lt;br&gt;动态块级缓存，基于残差差异&lt;/li&gt;&lt;li&gt;&lt;b&gt;TaylorSeer&lt;/b&gt;&lt;br&gt;Taylor 展开预测隐藏状态&lt;/li&gt;&lt;li&gt;&lt;b&gt;SCM (Step Computation Masking)&lt;/b&gt;&lt;br&gt;动态跳过计算步骤&lt;/li&gt;&lt;li&gt;&lt;b&gt;BlockAdapter&lt;/b&gt;&lt;br&gt;支持多 block list 和 dual-transformer&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1110" y="395" width="280" height="200" as="geometry" />
        </mxCell>
        
        <!-- Implementation Steps -->
