@misc{TridentServeStagelevelServingXia2025,
	title = {{TridentServe}: {A} {Stage}-level {Serving} {System} for {Diffusion} {Pipelines}},
	shorttitle = {{TridentServe}},
	url = {http://arxiv.org/abs/2510.02838},
	doi = {10.48550/arXiv.2510.02838},
	abstract = {Diffusion pipelines, renowned for their powerful visual generation capabilities, have seen widespread adoption in generative vision tasks (e.g., text-to-image/video). These pipelines typically follow an encode--diffuse--decode three-stage architecture. Current serving systems deploy diffusion pipelines within a static, manual, and pipeline-level paradigm, allocating the same resources to every request and stage. However, through an in-depth analysis, we find that such a paradigm is inefficient due to the discrepancy in resource needs across the three stages of each request, as well as across different requests. Following the analysis, we propose the dynamic stage-level serving paradigm and develop TridentServe, a brand new diffusion serving system. TridentServe automatically, dynamically derives the placement plan (i.e., how each stage resides) for pipeline deployment and the dispatch plan (i.e., how the requests are routed) for request processing, co-optimizing the resource allocation for both model and requests. Extensive experiments show that TridentServe consistently improves SLO attainment and reduces average/P95 latencies by up to 2.5x and 3.6x/4.1x over existing works across a variety of workloads.},
	urldate = {2026-04-29},
	publisher = {arXiv},
	author = {Xia, Yifei and Fu, Fangcheng and Yuan, Hao and Zhang, Hanke and Miao, Xupeng and Liu, Yijun and Ling, Suhan and Jiang, Jie and Cui, Bin},
	month = oct,
	year = {2025},
	note = {arXiv:2510.02838 [cs]},
	keywords = {Computer Science - Distributed, Parallel, and Cluster Computing},
	file = {Preprint PDF:/home/lyxwxj/Zotero/storage/94CTGGN8/Xia 等 - 2025 - TridentServe A Stage-level Serving System for Diffusion Pipelines.pdf:application/pdf;Snapshot:/home/lyxwxj/Zotero/storage/GUWSXD52/2510.html:text/html},
}

@misc{GENSERVEEfficientCoServingYe2026,
	title = {{GENSERVE}: {Efficient} {Co}-{Serving} of {Heterogeneous} {Diffusion} {Model} {Workloads}},
	shorttitle = {{GENSERVE}},
	url = {http://arxiv.org/abs/2604.04335},
	doi = {10.48550/arXiv.2604.04335},
	abstract = {Diffusion models have emerged as the prevailing approach for text-to-image (T2I) and text-to-video (T2V) generation, yet production platforms must increasingly serve both modalities on shared GPU clusters while meeting stringent latency SLOs. Co-serving such heterogeneous workloads is challenging: T2I and T2V requests exhibit vastly different compute demands, parallelism characteristics, and latency requirements, leading to significant SLO violations in existing serving systems. We present GENSERVE, a co-serving system that leverages the inherent predictability of the diffusion process to optimize serving efficiency. A central insight is that diffusion inference proceeds in discrete, predictable steps and is naturally preemptible at step boundaries, opening a new design space for heterogeneity-aware resource management. GENSERVE introduces step-level resource adaptation through three coordinated mechanisms: intelligent video preemption, elastic sequence parallelism with dynamic batching, and an SLO-aware scheduler that jointly optimizes resource allocation across all concurrent requests. Experimental results show that GENSERVE improves the SLO attainment rate by up to 44\% over the strongest baseline across diverse configurations.},
	urldate = {2026-04-29},
	publisher = {arXiv},
	author = {Ye, Fanjiang and Li, Zhangke and Zhong, Xinrui and Ma, Ethan and Chen, Russell and Wang, Kaijian and Zuo, Jingwei and Sun, Desen and Cao, Ye and Cao, Triston and Lee, Myungjin and Krishnamurthy, Arvind and Wang, Yuke},
	month = apr,
	year = {2026},
	note = {arXiv:2604.04335 [cs]},
	keywords = {Computer Science - Distributed, Parallel, and Cluster Computing},
	file = {Preprint PDF:/home/lyxwxj/Zotero/storage/A5HS54E7/Ye 等 - 2026 - GENSERVE Efficient Co-Serving of Heterogeneous Diffusion Model Workloads.pdf:application/pdf;Snapshot:/home/lyxwxj/Zotero/storage/SKRGQSDL/2604.html:text/html},
}

@inproceedings{OrcaDistributedServingYu2022,
	address = {Carlsbad, CA, USA},
	series = {{OSDI} '22},
	title = {Orca: {A} {Distributed} {Serving} {System} for {Transformer}-{Based} {Generative} {Models}},
	isbn = {978-1-939133-28-1},
	shorttitle = {Orca},
	url = {https://www.usenix.org/conference/osdi22/presentation/yu},
	abstract = {Large-scale Transformer-based generative models (e.g., GPT, BART) have achieved great success in numerous NLP tasks. However, their deployment in production is challenging due to the high latency and resource demands, exacerbated by recent increases in model size. Although there have been many algorithmic optimizations for inference, there are still inefficiencies in today's serving systems because they treat the generation process as a single monolithic unit. We present Orca, a distributed serving system that significantly improves the resource efficiency of serving generative models. Orca's core insight is that generative model inference can be decomposed into iterations, each of which processes one token, and that out-of-order execution across batches allows Orca to form a new batch as soon as a request is ready for the next iteration, instead of waiting for an entire batch to complete. This iteration-level scheduling, also known as continuous batching, significantly increases throughput while maintaining low latency. Orca additionally uses selective batching to support complex decoding algorithms, and a scheduling policy that respects fine-grained delays and prefills. Our evaluations demonstrate that Orca achieves up to 36× higher throughput compared to prior serving systems.},
	language = {en},
	urldate = {2026-04-29},
	booktitle = {Proceedings of the 16th {USENIX} {Symposium} on {Operating} {Systems} {Design} and {Implementation}},
	publisher = {USENIX Association},
	author = {Yu, Gyeong-In and Jeong, Jaehong and Kim, Geon-Woo and Kim, Sooyeong and Chun, Byung-Gon},
	month = jul,
	year = {2022},
	pages = {521--538},
}

@misc{CacheDiTTrainingfreeCache2025,
	title = {{CacheDiT}: {A} {Training}-free and {Easy}-to-use {Cache} {Acceleration} {Toolbox} for {Diffusion} {Transformers}},
	shorttitle = {{CacheDiT}},
	url = {https://github.com/vipshop/cache-dit},
	abstract = {CacheDiT is a training-free, easy-to-use cache acceleration toolbox for Diffusion Transformers (DiTs). It provides DBCache (Dual Block Cache), FBCache (First Block Cache), DBPrune (Dynamic Block Pruning), and TaylorSeer techniques to accelerate DiT inference through feature caching across denoising steps. CacheDiT supports separate CFG caching and hybrid cache strategies, achieving up to 3.3x speedup on FLUX.1, Wan 2.1, and other DiT models.},
	urldate = {2026-04-29},
	author = {{vipshop.com}},
	year = {2025},
}
